{
  "name": "p2p-eco",
  "version": "0.0.1",
  "description": "P2P network created to keep various archives synchronized, which can be integrated with a custom function to interact with external services, databases or much more.",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "build": "rspack build",
    "lint": "eslint .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonegosetto/p2p-eco.git"
  },
  "keywords": [
    "p2p",
    "network",
    "sync"
  ],
  "author": "Simone Gosetto",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/simonegosetto/p2p-eco/issues"
  },
  "homepage": "https://github.com/simonegosetto/p2p-eco#readme",
  "dependencies": {
    "dat-swarm-defaults": "^1.0.3",
    "discovery-swarm": "^6.1.0",
    "get-port": "^6.1.2",
    "msgpack-lite": "^0.1.26",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.2.2",
    "@rspack/core": "^2.2.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  }
}
