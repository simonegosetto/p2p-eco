# discovery topic joined by the swarm
P2P_CHANNEL=SyncChannel

# listen port; leave empty to let get-port pick a free one
P2P_PORT=

# overrides the derived node id (useful to run several nodes on one host)
P2P_NODE_ID=

# how often ResourceManager.check() runs, in milliseconds
P2P_CHECK_INTERVAL_MS=5000

# frames announcing more than this many bytes are refused
P2P_MAX_FRAME_BYTES=1048576

# silent | error | warn | info | debug
LOG_LEVEL=info
